# MedTermQuest — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to version control

# ── Security ──────────────────────────────────────────────────────────────────
# Change this to a long random string in production
# Generate one: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=medterm-secret-key-change-in-production-2024

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (development — file created automatically)
DATABASE_URL=sqlite:///./medterm.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/medterm_db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── App ───────────────────────────────────────────────────────────────────────
ENV=development
DEBUG=true
